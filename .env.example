# ---------------------------------------------------------------------------
# SITE DOMAIN (the only variable you need when moving to a new domain)
# ---------------------------------------------------------------------------
#
# Every absolute URL the site emits — canonical tag, Open Graph, sitemap.xml,
# robots.txt, the JSON-LD identity graph, and the domain printed on the share
# card — is built from this. Nothing is hard-coded anywhere in src/.
#
# Set it and redeploy; that is the entire move. Leave it unset on Vercel,
# Netlify or Cloudflare Pages and the host's own production domain is detected
# automatically (see src/lib/site.ts for the resolution order). Falls back to
# http://localhost:3000 for local development.
#
# READ AT BUILD TIME. The homepage is statically prerendered, so these URLs are
# baked into the HTML when `next build` runs — setting this only in the running
# container will not change them. Every managed host (Vercel, Netlify,
# Cloudflare) exposes its environment to the build, so this is automatic there;
# a hand-rolled Docker build needs the value passed to the build stage, not
# just the run stage.
#
# Include the scheme and no trailing slash.
NEXT_PUBLIC_SITE_URL=https://bakul.app

# Google Search Console verification token (optional).
#
# Only the raw token, not the whole meta tag. Left unset, the verification tag
# is simply omitted rather than emitted empty. Kept in the environment so
# re-verifying on a new domain also needs no code change.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Contact form delivery (optional).
#
# Without RESEND_API_KEY the contact endpoint returns HTTP 503 and tells the
# visitor to email directly. It never reports a message as sent when it was not.
#
# Get a key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From address for outgoing mail. Must be a domain verified in Resend.
# Defaults to Resend's shared onboarding sender if unset.
CONTACT_FROM="Portfolio <onboarding@resend.dev>"

# Where messages actually land. Without a verified domain, Resend's sandbox
# mode only delivers to the address that owns the API key — which may not be
# the address shown publicly on the site. Defaults to the site's displayed
# contact email if unset; override once a domain is verified.
CONTACT_TO=you@example.com
